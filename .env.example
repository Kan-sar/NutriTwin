# Copy to .env for local development. Never commit .env.
NUTRITWIN_ENVIRONMENT=development
NUTRITWIN_DATABASE_URL=postgresql+psycopg://nutritwin:nutritwin_local_only@postgres:5432/nutritwin # pragma: allowlist secret -- public local-only example
NUTRITWIN_REDIS_URL=redis://redis:6379/0
NUTRITWIN_NEO4J_URI=bolt://neo4j:7687
NUTRITWIN_NEO4J_USER=neo4j
NUTRITWIN_NEO4J_PASSWORD=nutritwin_local_only
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NUTRITWIN_JWT_SECRET=replace-with-at-least-32-random-characters
NUTRITWIN_ACCESS_TOKEN_MINUTES=15
NUTRITWIN_REFRESH_TOKEN_DAYS=7
NUTRITWIN_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
NUTRITWIN_LLM_ENABLED=false
